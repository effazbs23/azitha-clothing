<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_ppid" model="ir.ui.view">
        <field name="name">purchase.order.form.ppid</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Place the new PPID field right after the Vendor field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ppid"/>
            </xpath>
        </field>
    </record>
</odoo>
